<?xml version="1.0" encoding="utf-8" ?>
<views:FairyBasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:dislMagicGarden.Properties"
             x:Class="dislMagicGarden.Views.HomePage"
             xmlns:helpers="clr-namespace:dislMagicGarden.Helpers"
             xmlns:views="clr-namespace:dislMagicGarden.Views"
             xmlns:vm="clr-namespace:dislMagicGarden.ViewModels"
             Title="Magic Garden">

    <Grid>
        <!-- OPTIONAL: Hintergrundbild -->
        <!--<Image Source="background_magic.jpg"
               Aspect="AspectFill"
               Opacity="0.25"
               ZIndex="-1" />-->

        <ScrollView>
            <VerticalStackLayout Padding="15">

                <!-- Version und Sprache sind in den Einstellungen -->

                <!-- Kind-Profile: Tipp wechselt, Tipp auf aktives Profil bearbeitet, ＋ legt neues an -->
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Padding="0,10,0,0">
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding ProfileChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChildProfileChipItem">
                                <Border StrokeShape="RoundRectangle 18"
                                        Stroke="{DynamicResource ThemePrimaryColor}"
                                        StrokeThickness="1.5"
                                        BackgroundColor="Transparent"
                                        Padding="14,6">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimaryColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=SelectProfileCommand, x:DataType=vm:HomeViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding DisplayText}"
                                           FontSize="15"
                                           LineBreakMode="TailTruncation"
                                           MaximumWidthRequest="85"
                                           TextColor="{DynamicResource ThemeLabelColor}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <!-- Neues Profil -->
                    <Border StrokeShape="RoundRectangle 18"
                            Stroke="{DynamicResource ThemePrimaryColor}"
                            StrokeThickness="1.5"
                            StrokeDashArray="3,2"
                            BackgroundColor="Transparent"
                            Padding="14,6"
                            IsVisible="{Binding CanAddProfile}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddProfileCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding AddProfileText}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemePrimaryColor}" />
                    </Border>
                </HorizontalStackLayout>

                <VerticalStackLayout Padding="12" Spacing="10">
                    <!-- Header Illustration -->
                    <Border BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 30"
                        StrokeThickness="0"
                        Margin="0"
                        Padding="0">
                        <Border.Shadow>
                            <Shadow />
                        </Border.Shadow>
                        <Image Source="{Binding HeaderTaleImage}"
                           Aspect="AspectFit"
                           HeightRequest="170" />
                    </Border>

                    <!-- Titel -->
                    <Label Text="{helpers:Translate Key=Home_Welcome}"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       FontSize="16"
                        Style="{StaticResource FairyLabelStyle}" />

                    <!-- Auto-Generate  Button -->
                    <Border StrokeShape="RoundRectangle 25"
                        BackgroundColor="{StaticResource BlossomPink}"
                        StrokeThickness="0"
                        Margin="0"
                        Padding="0">
                        <Border.Shadow>
                            <Shadow   />
                        </Border.Shadow>


                        <Button Text="{helpers:Translate Key=Home_NewStory}"
                            Clicked="GoToNewStory_Clicked"              
                            FontSize="16"
                            TextColor="White"
                            HeightRequest="42"
                         />

                    </Border>

                    <!-- Semi-automatic generate Button -->
                    <Border StrokeShape="RoundRectangle 25"
                         BackgroundColor="{StaticResource BlossomPink}"
                         StrokeThickness="0"
                         Margin="0"
                         Padding="0">
                        <Border.Shadow>
                            <Shadow   />
                        </Border.Shadow>
                        <Button Text="{helpers:Translate Key=Create_history_interactively}"
                             Clicked="SemiAutomaticGenerate_Clicked"              
                             FontSize="16"
                             TextColor="White"
                             HeightRequest="42"
                              />
                    </Border>

                    <!-- Kind-Profil Button (Beschreibung fließt in alle Prompts ein) -->
                    <Border StrokeShape="RoundRectangle 25"
                         BackgroundColor="{StaticResource BlossomPink}"
                         StrokeThickness="0"
                         Margin="0"
                         Padding="0">
                        <Border.Shadow>
                            <Shadow   />
                        </Border.Shadow>
                        <Button Text="{helpers:Translate Key=Child_description}"
                             Command="{Binding EditActiveProfileCommand}"
                             FontSize="16"
                             TextColor="White"
                             HeightRequest="42" />
                    </Border>

                    <!-- Setup / Einstellungen Button -->
                    <Border StrokeShape="RoundRectangle 25"
                         BackgroundColor="{StaticResource BlossomPink}"
                         StrokeThickness="0"
                         Margin="0"
                         Padding="0">
                        <Border.Shadow>
                            <Shadow   />
                        </Border.Shadow>
                        <Button Text="{helpers:Translate Key=SettingsButton}"
                             Clicked="GoToSettings_Clicked"
                             FontSize="16"
                             TextColor="White"
                             HeightRequest="42" />
                    </Border>

                    <!-- Sketch generate Button -->
                    <!--<Border StrokeShape="RoundRectangle 25"
                              BackgroundColor="{StaticResource BlossomPink}"
                              StrokeThickness="0"
                              Margin="0"
                              Padding="0">          
                        <Border.Shadow>
                            <Shadow   />
                        </Border.Shadow>
                        <Button Text="{helpers:Translate Key=Fairy_tales_through_sketches}"
                              Clicked="Fairy_tales_through_sketches_Clicked"              
                              FontSize="16"
                              TextColor="White"
                              HeightRequest="42"
                               />   
                    </Border>-->

                    <!-- Maskottchen -->
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Image Source="character_bunny.webp"
                           HeightRequest="150"
                           Aspect="AspectFit" />
                        <Label Text="{helpers:Translate Key=Luna_is_waiting}"
                           FontSize="14"
                           Style="{StaticResource FairyLabelStyle}"
                           HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</views:FairyBasePage>